# Copie para .env e preencha. Nunca commite o .env.

# --- Aplicação ---
NODE_ENV=development
API_PORT=3000
COMPANY_NAME="Minha Empresa"
TZ=America/Sao_Paulo

# --- Banco (docker-compose cria com estes valores) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=cobranca
DB_PASSWORD=cobranca
DB_NAME=cobranca

# --- Login ---
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria
JWT_EXPIRES_IN=8h
# Usados por `npm run seed:admin` para criar o primeiro usuário
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-esta-senha

# --- Cora (stage ou produção; credenciais são diferentes em cada um) ---
CORA_BASE_URL=https://api.stage.cora.com.br
CORA_TOKEN_URL=https://matls-clients.api.stage.cora.com.br/token
CORA_CLIENT_ID=
# Pasta local com certificate.pem e private-key.key (montada em /certs no docker)
CORA_CERT_DIR=./certs
CORA_CERT_PATH=/certs/certificate.pem
CORA_KEY_PATH=/certs/private-key.key

# --- Regras de emissão ---
ISSUE_DAYS_BEFORE_DUE=10
REMINDER_DAYS_BEFORE_DUE=3
OVERDUE_NOTICE_DAYS_AFTER_DUE=1
MAX_ISSUE_ATTEMPTS=3

# --- E-mail (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=cobranca@seudominio.com.br
# Quem recebe o aviso interno quando uma parcela falha na emissão
INTERNAL_ALERT_EMAIL=financeiro@seudominio.com.br
